#KMF VERSION 1.0

//Manifest file for use with kalamove. Read more at https://github.com/kalakit/kalamove

//
// CORE STUFF
//

//copy readme
origin: README.md
target: ..@external-shared@KalaCLI@README.md
action: forcecopy

//copy license
origin: LICENSE.md
target: ..@external-shared@KalaCLI@LICENSE.md
action: forcecopy

//copy include files
origin: include
target: ..@external-shared@KalaCLI@include
action: forcecopy

//copy docs
origin: docs
target: ..@external-shared@KalaCLI@docs
action: forcecopy

//
// BINARIES
//

//copy debug
origin: build@debug-linux@libkalaclid.a
target: ..@external-shared@KalaCLI@debug@libkalaclid.a
action: forcecopy

//copy release
origin: build@release-linux@libkalacli.a
target: ..@external-shared@KalaCLI@release@libkalacli.a
action: forcecopy
