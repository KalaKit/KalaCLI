#KMF VERSION 1.0

//Manifest file for use with kalamove. Read more at https://github.com/kalakit/kalamove

//
// CORE STUFF
//

//copy readme
origin: README.md
target: ..@kalafont@_external_shared@KalaCLI@README.md, ..@kalamodel@_external_shared@KalaCLI@README.md, ..@kalamove@_external_shared@KalaCLI@README.md, ..@kalamake@_external_shared@KalaCLI@README.md
action: forcecopy

//copy license
origin: LICENSE.md
target: ..@kalafont@_external_shared@KalaCLI@LICENSE.md, ..@kalamodel@_external_shared@KalaCLI@LICENSE.md, ..@kalamove@_external_shared@KalaCLI@LICENSE.md, ..@kalamake@_external_shared@KalaCLI@LICENSE.md
action: forcecopy

//copy include files
origin: include
target: ..@kalafont@_external_shared@KalaCLI@include, ..@kalamodel@_external_shared@KalaCLI@include, ..@kalamove@_external_shared@KalaCLI@include, ..@kalamake@_external_shared@KalaCLI@include
action: forcecopy

//copy docs
origin: docs
target: ..@kalafont@_external_shared@KalaCLI@docs, ..@kalamodel@_external_shared@KalaCLI@docs, ..@kalamove@_external_shared@KalaCLI@docs, ..@kalamake@_external_shared@KalaCLI@docs
action: forcecopy

//
// BINARIES
//

//copy debug lib
origin: build@debug-windows@kalaclid.lib
target: ..@kalafont@_external_shared@KalaCLI@debug@kalaclid.lib, ..@kalamodel@_external_shared@KalaCLI@debug@kalaclid.lib, ..@kalamove@_external_shared@KalaCLI@debug@kalaclid.lib, ..@kalamake@_external_shared@KalaCLI@debug@kalaclid.lib
action: forcecopy

//copy release lib
origin: build@release-windows@kalacli.lib
target: ..@kalafont@_external_shared@KalaCLI@release@kalacli.lib, ..@kalamodel@_external_shared@KalaCLI@release@kalacli.lib, ..@kalamove@_external_shared@KalaCLI@release@kalacli.lib, ..@kalamake@_external_shared@KalaCLI@release@kalacli.lib
action: forcecopy

//
// EXTERNAL LIBRARIES
//

//KalaHeaders
origin: _external_shared@KalaHeaders
target: ..@kalafont@_external_shared@KalaHeaders, ..@kalamodel@_external_shared@KalaHeaders, ..@kalamove@_external_shared@KalaHeaders, ..@kalamake@_external_shared@KalaHeaders
action: copy
