//Build script for use with kalamake. Read more at https://github.com/kalakit/kalamake

#version 1.0

#include
kh: "_external_shared"

#global
compilerlauncher: ccache
standard: c++20
binarytype: static
sources: "src"
headers: "include", #kh
warninglevel: normal

#profile debug-windows
binaryname: KalaCLI1d
compiler: clang-cl
buildtype: debug
buildpath: "build/debug-windows"

#profile release-windows
binaryname: KalaCLI1
compiler: clang-cl
buildtype: minsizerel
buildpath: "build/release-windows"

#profile debug-linux
binaryname: libKalaCLI1d
compiler: clang++
buildtype: debug
buildpath: "build/debug-linux"

#profile release-linux
binaryname: libKalaCLI1
compiler: clang++
buildtype: minsizerel
buildpath: "build/release-linux"
